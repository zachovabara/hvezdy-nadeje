<script type="text/javascript">
/*<![CDATA[*/
Wicket.Event.add(window, "load", function(event) { 
// Provides records of user activity
class UserActivityListener {
    #lastActivityUserTimestamp;
    #countOfKeyPressed;

    constructor() {
        this.resetActivity();
    }

    getUserActivity(currentTime) {
        return {
            userIdleTime: (this.hasNoActivity()) ? 0 : currentTime - this.#lastActivityUserTimestamp,
            countOfKeyPressed: this.#countOfKeyPressed
        };
    }

    updateActivity() {
        this.#lastActivityUserTimestamp = Date.now();
        this.#countOfKeyPressed++;
    }

    resetActivity() {
        this.#lastActivityUserTimestamp = 0;
        this.#countOfKeyPressed = 0;
    }

    hasNoActivity() {
        return this.#lastActivityUserTimestamp === 0;
    }
}

// Provides a service to manage the logout time cookies
class LogoutTimeCookiesService {
    #parsedCookie;
    #previousCookies;

    constructor() {
        this.#previousCookies = docCookies.getItem('__Host-IB2_jsLogoutTime');
        this.#parsedCookie = this.#getParsedCookie(this.#previousCookies)
    }

    #getParsedCookie(cookie) {
        const cookieParts = cookie.split('|');
        return {
            modalDialogTimestamp: +cookieParts[2],
            logoutTimestamp: +cookieParts[3]
        }
    }

    isNewCookie() {
        const currentCookies = docCookies.getItem('__Host-IB2_jsLogoutTime');
        if (currentCookies !== this.#previousCookies) {
            this.#previousCookies = currentCookies;
            this.#parsedCookie = this.#getParsedCookie(currentCookies);
            return true;
        } else {
            return false;
        }
    }

    get getCookie() {
        return this.#parsedCookie;
    }
}

(function () {
    const AUTOMATIC_TIME_EXTENSION_OFFSET = 5000; // 5s
    const INTERVAL_TIMEOUT = 1000; // 1s
    const userActivityListener = new UserActivityListener();
    const logoutTimeCookiesService = new LogoutTimeCookiesService();
    const $logoutModalDialog = $('#id8fd18182114fa84255');
    let isTimeExtensionRequestSent = false;

    // Function declarations
    function reset() {
        if (isTimeExtensionRequestSent) {
            isTimeExtensionRequestSent = false;
        }
        if ($logoutModalDialog.is(':visible')) {
            $logoutModalDialog.modal('hide');
        }
    }

    function getCurrentCookie() {
        if (logoutTimeCookiesService.isNewCookie()) {
            userActivityListener.resetActivity();
            reset();
        }
        return logoutTimeCookiesService.getCookie;
    }

    function processTheLogout(intervalID) {
        clearInterval(intervalID);
        window.location.replace('../../logout');
    }

    function processTheDisplayOfDialog() {
        if ($logoutModalDialog.is(':hidden')) {
            $logoutModalDialog.modal('show');
        }
    }

    function processTheAutomaticTimeExtension(currentTimestamp) {
        if (isTimeExtensionRequestSent || userActivityListener.hasNoActivity()) {
            return;
        }
        const userActivity = userActivityListener.getUserActivity(currentTimestamp);
        let callbackPost = function (userIdleTimeParam,countOfKeyPressedParam) {
var attrs = {"u":"./zaplat-mi?3-2.0-logoutDialog-stayLoggedInLink","m":"POST","c":"id3c0d16465a70ad0757","i":"id3c0d16465a70ad0757--ajax-indicator"};
var params = [{"name":"userIdleTimeParam","value":userIdleTimeParam},{"name":"countOfKeyPressedParam","value":countOfKeyPressedParam}];
attrs.ep = params.concat(attrs.ep || []);
Wicket.Ajax.ajax(attrs);
}
;
        callbackPost(userActivity.userIdleTime, userActivity.countOfKeyPressed);
        isTimeExtensionRequestSent = true;
    }

    // The main script run
    document.addEventListener("keyup", userActivityListener.updateActivity.bind(userActivityListener));
    const intervalID = setInterval(() => {
        const cookie = getCurrentCookie();
        if (cookie === null || cookie === undefined) {
            return;
        }
        const timestampToDisplayModalDialog = cookie.modalDialogTimestamp;
        const timestampToLogout = cookie.logoutTimestamp;
        const currentTimestamp = Date.now();
        if (timestampToDisplayModalDialog != null && timestampToLogout != null) {
            const timestampToAutomaticTimeExtension = timestampToDisplayModalDialog - AUTOMATIC_TIME_EXTENSION_OFFSET
            if (currentTimestamp > timestampToLogout) {
                processTheLogout(intervalID);
            } else if (currentTimestamp > timestampToDisplayModalDialog) {
                processTheDisplayOfDialog();
            } else if (currentTimestamp > timestampToAutomaticTimeExtension) {
                processTheAutomaticTimeExtension(currentTimestamp);
            }
        }
    }, INTERVAL_TIMEOUT); // every second
})();
;
